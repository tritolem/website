---
import { docsUrl } from '../lib/paths';
---

<footer class="site-footer">
	<div class="wrap site-footer-inner">
		<p>Tritolem is in early, greenfield development.</p>
		<nav aria-label="Footer">
			<a href={docsUrl}>Documentation</a>
			<a href="https://github.com/tritolem" target="_blank" rel="noopener noreferrer">GitHub</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--c-card-border);
		margin-top: 4rem;
	}

	.site-footer-inner {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-block: 2rem;
		color: var(--c-text-muted);
		font-size: 0.9rem;
	}

	.site-footer-inner nav {
		display: flex;
		gap: 1.25rem;
	}

	.site-footer-inner a {
		color: var(--c-text-muted);
	}

	.site-footer-inner a:hover {
		color: var(--c-accent);
	}

	@media (min-width: 48em) {
		.site-footer-inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>
