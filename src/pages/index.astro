---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsUrl = `${base}/docs/`;
const faviconUrl = `${base}/favicon.svg`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Tritolem</title>
		<meta name="description" content="Tritolem is in early, greenfield development." />
	</head>
	<body>
		<main>
			<h1>Tritolem</h1>
			<p>
				Tritolem is in early, greenfield development. This site is a
				placeholder for the product marketing page. No feature is released
				yet.
			</p>
			<p><a href={docsUrl}>Read the documentation placeholder &rarr;</a></p>
		</main>
	</body>
</html>
